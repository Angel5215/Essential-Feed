# General Options
--swift-version 6.4.2

# File Options
--exclude Stage,Tasks/.build,ThirdParty,**/SwiftGen/*,**/Sourcery/*,Frameworks/swift-composable-architecture,**.generated.swift

# Format Options
--exponent-case uppercase
--fraction-grouping enabled
--header \n{file}\nCopyright © {year} Ángel Vázquez. All rights reserved.\n
--hex-literal-case uppercase
--import-grouping alpha
--indent 4
--max-width 180
--no-space-operators ..<,...
--prefer-content-builder true
--self init-only
--strip-unused-args closure-only
--trailing-commas multi-element-lists
--wrap-arguments before-first
--wrap-collections before-first
--wrap-parameters before-first

# Rules
# --disable hoistAwait
# --disable hoistPatternLet
# --disable hoistTry
--disable noForceTryInTests
--disable noForceUnwrapInTests
--disable preferSwiftTesting
--disable wrapMultilineStatementBraces

--enable acronyms
--enable blankLineAfterSwitchCase
--enable blockComments
--enable emptyExtensions
--enable isEmpty
--enable noGuardInTests
--enable preferFinalClasses
--enable privateSwiftUIDynamicProperties
# --enable singlePropertyPerLine
--enable wrapEnumCases
--enable wrapMultilineFunctionChains
