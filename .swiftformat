# General Options
--swiftversion 6.3.2

# File Options
--exclude Stage,Tasks/.build,ThirdParty,**/SwiftGen/*,**/Sourcery/*,Frameworks/swift-composable-architecture,**.generated.swift

# Format Options
--exponentcase uppercase
--fractiongrouping enabled
--header \n{file}\nCopyright © {year} Ángel Vázquez. All rights reserved.\n
--hexliteralcase uppercase
--importgrouping alpha
--indent 4
--maxwidth 180
--nospaceoperators ..<,...
--self init-only
--stripunusedargs closure-only
--trailingcommas multi-element-lists
--wraparguments before-first
--wrapcollections before-first
--wrapparameters before-first

# Rules
# --disable hoistAwait
# --disable hoistPatternLet
# --disable hoistTry
--disable preferSwiftTesting
--disable wrapMultilineStatementBraces

--enable acronyms
--enable blankLineAfterSwitchCase
--enable blankLinesBetweenImports
--enable blockComments
--enable emptyExtensions
--enable environmentEntry
--enable isEmpty
# --enable noForceTryInTests
# --enable noForceUnwrapInTests
--enable noGuardInTests
--enable preferFinalClasses
--enable privateStateVariables
--enable redundantEquatable
--enable redundantMemberwiseInit
--enable redundantVariable
# --enable singlePropertyPerLine
--enable wrapEnumCases
--enable wrapMultilineFunctionChains
